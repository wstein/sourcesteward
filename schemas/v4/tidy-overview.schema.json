{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "maxLength": 512,
          "type": "string"
        },
        "group": {
          "description": "Opaque stable key of the overview group of a green, yellow or orange row.",
          "pattern": "^group[a-p]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "worktree",
            "branch",
            "tracking-ref",
            "stale-worktree"
          ]
        },
        "owner": {
          "type": "string"
        },
        "owner_source": {
          "enum": [
            "task-record",
            "path-convention",
            "commit-author",
            "unknown"
          ]
        },
        "path": {
          "type": "string"
        },
        "pr": {
          "description": "Number of the pull request merged into the base whose head is the tip (online evidence only).",
          "minimum": 1,
          "type": "integer"
        },
        "proof": {
          "enum": [
            "ancestor",
            "patch-id",
            "merge-noop",
            "no-net-change",
            "empty-working-copy-integrated-parent",
            "github-branch-absent",
            "none"
          ]
        },
        "reason": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "risk": {
          "description": "Spec 044 risk level; present when the run clock was available. green, yellow and orange rows may be offered for deletion, red rows may hold unique work, kept rows are kept for a structural reason. A level is never integration evidence.",
          "enum": [
            "green",
            "yellow",
            "orange",
            "red",
            "kept"
          ]
        },
        "risk_reasons": {
          "description": "Stable kebab-case words that say why the row has its level; absent for a kept row.",
          "items": {
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "scope": {
          "enum": [
            "own",
            "other",
            "unknown"
          ]
        },
        "task": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "safe",
            "retain",
            "decision"
          ]
        }
      },
      "required": [
        "id",
        "repo",
        "kind",
        "verdict",
        "reason",
        "owner",
        "owner_source",
        "scope",
        "path",
        "branch",
        "task",
        "proof",
        "effects",
        "evidence"
      ],
      "type": "object"
    },
    "Derived": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "overridden": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "source",
        "overridden"
      ],
      "type": "object"
    },
    "Mode": {
      "additionalProperties": false,
      "properties": {
        "by_owner": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "caller": {
          "type": "string"
        },
        "caller_source": {
          "type": "string"
        },
        "markers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mine": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "stdin_tty": {
          "type": "boolean"
        },
        "stdout_tty": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "stdin_tty",
        "stdout_tty",
        "markers",
        "mine",
        "by_owner",
        "caller",
        "caller_source"
      ],
      "type": "object"
    },
    "RegistrationPrune": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "effects": {
                "maxItems": 0
              },
              "proof": {
                "const": "none"
              }
            }
          },
          "if": {
            "properties": {
              "verdict": {
                "const": "safe"
              }
            }
          },
          "then": {
            "properties": {
              "effects": {
                "minItems": 1
              },
              "evidence_digest": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "owner": {
                "minLength": 1
              },
              "owner_source": {
                "const": "task-record"
              },
              "proof": {
                "const": "owned-missing-registration"
              },
              "reason": {
                "const": "registration-prune-ready"
              },
              "task": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "orange"
              }
            },
            "required": [
              "risk"
            ]
          },
          "then": {
            "properties": {
              "destination": {
                "minLength": 1
              },
              "effects": {
                "const": [
                  "remove-registration"
                ]
              },
              "evidence_digest": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "gitdir": {
                "minLength": 1
              },
              "name": {
                "minLength": 1
              },
              "owner": {
                "minLength": 1
              },
              "owner_source": {
                "const": "task-record"
              },
              "proof": {
                "const": "owned-missing-registration"
              },
              "reason": {
                "const": "registration-prune-ready"
              },
              "repo": {
                "minLength": 1
              },
              "risk_reasons": {
                "const": [
                  "owned-missing-registration"
                ]
              },
              "scope": {
                "enum": [
                  "own",
                  "other"
                ]
              },
              "task": {
                "minLength": 1
              },
              "verdict": {
                "const": "safe"
              }
            },
            "required": [
              "risk_reasons"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "red"
              }
            },
            "required": [
              "risk"
            ]
          },
          "then": {
            "properties": {
              "risk_reasons": {
                "const": [
                  "not-judged"
                ]
              }
            },
            "required": [
              "risk_reasons"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "kept"
              }
            },
            "required": [
              "risk"
            ]
          },
          "then": {
            "not": {
              "required": [
                "risk_reasons"
              ]
            },
            "properties": {
              "reason": {
                "enum": [
                  "registration-prune-absence-unproven",
                  "registration-prune-ownership-unproven"
                ]
              },
              "verdict": {
                "const": "retain"
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "risk_reasons": [
          "risk"
        ]
      },
      "properties": {
        "destination": {
          "type": "string"
        },
        "effects": {
          "items": {
            "const": "remove-registration"
          },
          "maxItems": 1,
          "type": "array"
        },
        "evidence_digest": {
          "pattern": "^([0-9a-f]{64})?$",
          "type": "string"
        },
        "gitdir": {
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "const": "registration-prune"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "owner_source": {
          "enum": [
            "task-record",
            "unknown"
          ]
        },
        "proof": {
          "enum": [
            "owned-missing-registration",
            "none"
          ]
        },
        "reason": {
          "enum": [
            "registration-prune-ready",
            "registration-prune-absence-unproven",
            "registration-prune-ownership-unproven",
            "registration-prune-changed",
            "registration-prune-unsupported",
            "registration-prune-inventory-blocked",
            "registration-prune-recovery-unavailable"
          ]
        },
        "repo": {
          "type": "string"
        },
        "risk": {
          "description": "Owner-accepted native registration-prune display assessment (2026-10-27), never integration proof, selection or effect authorization. No green or yellow assessment.",
          "enum": [
            "orange",
            "red",
            "kept"
          ]
        },
        "risk_reasons": {
          "description": "Native display reason: owned-missing-registration for orange, not-judged for red; omitted for kept.",
          "items": {
            "enum": [
              "owned-missing-registration",
              "not-judged"
            ]
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "scope": {
          "enum": [
            "own",
            "other",
            "unknown"
          ]
        },
        "task": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "safe",
            "retain",
            "blocked",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "repo",
        "name",
        "gitdir",
        "destination",
        "owner",
        "owner_source",
        "scope",
        "task",
        "verdict",
        "reason",
        "proof",
        "effects",
        "evidence_digest",
        "limitations"
      ],
      "type": "object"
    },
    "RegistrationPruneRiskCounts": {
      "additionalProperties": false,
      "description": "All observed registration-prune rows in the filtered view per display risk before output truncation; separate from selected effects, legacy candidate totals and summary.risk. Native assessments are never green or yellow.",
      "properties": {
        "green": {
          "const": 0,
          "type": "integer"
        },
        "kept": {
          "minimum": 0,
          "type": "integer"
        },
        "orange": {
          "minimum": 0,
          "type": "integer"
        },
        "red": {
          "minimum": 0,
          "type": "integer"
        },
        "yellow": {
          "const": 0,
          "type": "integer"
        }
      },
      "required": [
        "green",
        "yellow",
        "orange",
        "red",
        "kept"
      ],
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "state": {
          "enum": [
            "analysed",
            "skipped",
            "error"
          ]
        }
      },
      "required": [
        "name",
        "path",
        "backend",
        "base",
        "remote",
        "state",
        "reason"
      ],
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "minimum": 0,
          "type": "integer"
        },
        "registration_prunes": {
          "$ref": "#/$defs/RegistrationPruneRiskCounts"
        },
        "retain": {
          "minimum": 0,
          "type": "integer"
        },
        "risk": {
          "additionalProperties": false,
          "description": "Candidates per risk level (Spec 044); present when the run clock was available.",
          "properties": {
            "green": {
              "minimum": 0,
              "type": "integer"
            },
            "kept": {
              "minimum": 0,
              "type": "integer"
            },
            "orange": {
              "minimum": 0,
              "type": "integer"
            },
            "red": {
              "minimum": 0,
              "type": "integer"
            },
            "yellow": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "green",
            "yellow",
            "orange",
            "red",
            "kept"
          ],
          "type": "object"
        },
        "safe": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "safe",
        "retain",
        "decision"
      ],
      "type": "object"
    }
  },
  "$id": "https://wstein.github.io/sourcesteward/schemas/v4/tidy-overview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit opt-in overview4, unpublished. Legacy candidates and summary keep their existing shape; registration_prunes has its own typed verdicts. The producer bounds both arrays together at 4096 and the whole document at 4 MiB.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "command": {
      "const": "tidy-overview"
    },
    "derived": {
      "items": {
        "$ref": "#/$defs/Derived"
      },
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "notices": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan_id": {
      "maxLength": 64,
      "pattern": "^([0-9a-f]{64})?$",
      "type": "string"
    },
    "registration_prunes": {
      "items": {
        "$ref": "#/$defs/RegistrationPrune"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "repositories": {
      "items": {
        "$ref": "#/$defs/Repository"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 4
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "truncated": {
      "type": "boolean"
    },
    "workspace": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command",
    "workspace",
    "derived",
    "repositories",
    "candidates",
    "summary",
    "mode",
    "plan_id",
    "notices",
    "truncated",
    "registration_prunes"
  ],
  "title": "stw tidy overview (Spec 041)",
  "type": "object"
}
