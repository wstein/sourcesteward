{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wstein.github.io/sourcesteward/schemas/v1/release-record-result.schema.json",
  "title": "SourceSteward record command result (schema 1)",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "status",
    "record",
    "path",
    "written",
    "canonical_sha256",
    "error",
    "backend"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "release-record"
    },
    "status": {
      "enum": [
        "ok",
        "refused",
        "failed",
        "error"
      ]
    },
    "record": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "title": "SourceSteward release record (schema 1)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "kind",
            "project",
            "version",
            "tag",
            "commit",
            "repository",
            "source_date_epoch",
            "build",
            "assets",
            "checksums",
            "manifest",
            "attestation"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "release-record"
            },
            "project": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._ -]{1,64}$"
            },
            "product": {
              "$ref": "#/$defs/id"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "tag": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]{1,128}$"
            },
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
            },
            "source_date_epoch": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow",
                "run_id",
                "run_attempt",
                "stw_version"
              ],
              "properties": {
                "workflow": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]{0,255}$"
                },
                "run_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "run_attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "stw_version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._+-]{1,64}$"
                }
              }
            },
            "assets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/asset"
              }
            },
            "checksums": {
              "$ref": "#/$defs/fileRef"
            },
            "manifest": {
              "$ref": "#/$defs/fileRef"
            },
            "attestation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "signer_workflow",
                "predicate_type"
              ],
              "properties": {
                "provider": {
                  "const": "github-artifact-attestation"
                },
                "signer_workflow": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._][A-Za-z0-9._/-]{0,255}$"
                },
                "predicate_type": {
                  "const": "https://slsa.dev/provenance/v1"
                }
              }
            }
          }
        }
      ]
    },
    "path": {
      "type": "string"
    },
    "written": {
      "type": "boolean"
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "backend": {
      "type": "string"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "pathSha": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]{0,255}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "role",
            "build",
            "name",
            "url_template",
            "sha256",
            "size",
            "os",
            "arch"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "artifact",
                "manifest",
                "metadata",
                "sbom"
              ]
            },
            "group": {
              "$ref": "#/$defs/id"
            },
            "build": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "$ref": "#/$defs/name"
            },
            "url_template": {
              "type": "string",
              "maxLength": 512
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            },
            "os": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,16}$"
            },
            "arch": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "role",
            "build",
            "repository",
            "index_digest",
            "platforms",
            "tags",
            "lock",
            "tool_list",
            "source_offer"
          ],
          "properties": {
            "kind": {
              "const": "oci-image"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "role": {
              "enum": [
                "artifact",
                "manifest",
                "metadata",
                "sbom"
              ]
            },
            "group": {
              "$ref": "#/$defs/id"
            },
            "build": {
              "$ref": "#/$defs/id"
            },
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,254}$"
            },
            "index_digest": {
              "$ref": "#/$defs/digest"
            },
            "platforms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "os",
                  "arch",
                  "manifest_digest"
                ],
                "properties": {
                  "os": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,16}$"
                  },
                  "arch": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,16}$"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]{1,16}$"
                  },
                  "manifest_digest": {
                    "$ref": "#/$defs/digest"
                  }
                }
              }
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
              }
            },
            "lock": {
              "$ref": "#/$defs/pathSha"
            },
            "tool_list": {
              "$ref": "#/$defs/pathSha"
            },
            "source_offer": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      ]
    }
  }
}
