{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wstein.github.io/sourcesteward/schemas/v1/pulls.schema.json",
  "title": "SourceSteward open pull request snapshot (schema 1)",
  "description": "Result of stw pulls --json: one document with every open pull request of the selected repositories, grouped by what needs action (Spec 036). Exit statuses: 0 all repositories read (also when nothing is open), 1 at least one repository or owner discovery failed (the document is still printed), 2 usage error with no JSON. Keys are never omitted; absent values are null. A row's url, created_at, age_days and head are null only when the forge gave no usable value. Added properties are compatible extensions. The conflicts member and the base_conflict row member are added by --conflicts (Spec 047).",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "time",
    "host",
    "options",
    "repos",
    "groups",
    "summary",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "pulls"
    },
    "time": {
      "$ref": "#/$defs/time"
    },
    "host": {
      "$ref": "#/$defs/str"
    },
    "options": {
      "type": "object",
      "required": [
        "scope",
        "owners",
        "no_bots",
        "bots_only",
        "authors",
        "detail_drafts",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "workspace",
            "repos",
            "mixed"
          ]
        },
        "owners": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "no_bots": {
          "type": "boolean"
        },
        "bots_only": {
          "type": "boolean"
        },
        "authors": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}(\\[bot\\])?$"
          }
        },
        "detail_drafts": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "review": {
          "type": "boolean"
        },
        "review_states": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/reviewState"
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/hint"
          }
        },
        "conflicts": {
          "type": "boolean"
        },
        "restack_plan": {
          "type": "boolean"
        },
        "mergeable": {
          "type": "boolean"
        },
        "stack": {
          "type": "boolean"
        }
      }
    },
    "repos": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "repo",
          "source",
          "open",
          "listed",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "$ref": "#/$defs/repo"
          },
          "source": {
            "enum": [
              "workspace",
              "repo",
              "owner"
            ]
          },
          "open": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "listed": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "anyOf": [
              {
                "enum": [
                  "rate-limited",
                  "network",
                  "unauthorized",
                  "forbidden",
                  "http-5xx",
                  "malformed-response",
                  "too-many-open-prs",
                  "page-too-large",
                  "repo-moved",
                  "search-incomplete",
                  "search-too-many"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "required": [
        "ready",
        "checks",
        "conflict",
        "draft",
        "blocked"
      ],
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "properties": {
                  "group": {
                    "const": "ready"
                  }
                }
              }
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "properties": {
                  "group": {
                    "const": "checks"
                  }
                }
              }
            ]
          }
        },
        "conflict": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "properties": {
                  "group": {
                    "const": "conflict"
                  }
                }
              }
            ]
          }
        },
        "draft": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "properties": {
                  "group": {
                    "const": "draft"
                  }
                }
              }
            ]
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/row"
              },
              {
                "properties": {
                  "group": {
                    "const": "blocked"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "ready",
        "checks",
        "conflict",
        "draft",
        "blocked",
        "bots",
        "not_read",
        "repos_read",
        "repos_failed"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "draft": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "bots": {
          "type": "integer",
          "minimum": 0
        },
        "not_read": {
          "type": "integer",
          "minimum": 0
        },
        "repos_read": {
          "type": "integer",
          "minimum": 0
        },
        "repos_failed": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "object",
          "required": [
            "none",
            "findings",
            "clear",
            "clear_carried",
            "clear_stale",
            "unparsed",
            "not_read"
          ],
          "additionalProperties": false,
          "properties": {
            "none": {
              "type": "integer",
              "minimum": 0
            },
            "findings": {
              "type": "integer",
              "minimum": 0
            },
            "clear": {
              "type": "integer",
              "minimum": 0
            },
            "clear_carried": {
              "type": "integer",
              "minimum": 0
            },
            "clear_stale": {
              "type": "integer",
              "minimum": 0
            },
            "unparsed": {
              "type": "integer",
              "minimum": 0
            },
            "not_read": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "hints": {
          "type": "object",
          "required": [
            "clear_not_ready",
            "no_final_review",
            "base_not_default",
            "parent_merged_retarget",
            "truncated_review_unknown",
            "foreign_review_ignored",
            "ready_mergeable"
          ],
          "additionalProperties": false,
          "properties": {
            "clear_not_ready": {
              "type": "integer",
              "minimum": 0
            },
            "no_final_review": {
              "type": "integer",
              "minimum": 0
            },
            "base_not_default": {
              "type": "integer",
              "minimum": 0
            },
            "parent_merged_retarget": {
              "type": "integer",
              "minimum": 0
            },
            "truncated_review_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "foreign_review_ignored": {
              "type": "integer",
              "minimum": 0
            },
            "ready_mergeable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "base_conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_for_parent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "owner",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "anyOf": [
              {
                "$ref": "#/$defs/repo"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/$defs/owner"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "enum": [
              "rate-limited",
              "network",
              "unauthorized",
              "forbidden",
              "http-5xx",
              "malformed-response",
              "too-many-open-prs",
              "page-too-large",
              "repo-moved",
              "search-incomplete",
              "search-too-many"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        },
        "oneOf": [
          {
            "properties": {
              "repo": {
                "type": "string"
              },
              "owner": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "repo": {
                "type": "null"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "conflicts": {
      "anyOf": [
        {
          "$ref": "#/$defs/conflictsDoc"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_queue": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queueEntry"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "stack": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "trees",
            "singles"
          ],
          "additionalProperties": false,
          "properties": {
            "trees": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stackNode"
              }
            },
            "singles": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "str": {
      "type": "string",
      "maxLength": 2048,
      "description": "At most 2048 bytes in the producer; maxLength counts characters."
    },
    "names": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/str"
      }
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9]|-[A-Za-z0-9]){0,38}$"
    },
    "row": {
      "type": "object",
      "required": [
        "repo",
        "number",
        "title",
        "url",
        "author",
        "bot",
        "draft",
        "created_at",
        "age_days",
        "base",
        "head_ref",
        "head",
        "fork",
        "labels",
        "checks",
        "failing",
        "mergeable",
        "mergeable_state",
        "rebaseable",
        "reviewers",
        "group",
        "reason",
        "ready",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/str"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "$ref": "#/$defs/str"
        },
        "bot": {
          "type": "boolean"
        },
        "draft": {
          "type": "boolean"
        },
        "created_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "$ref": "#/$defs/str"
        },
        "head_ref": {
          "$ref": "#/$defs/str"
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "fork": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/names"
        },
        "checks": {
          "anyOf": [
            {
              "enum": [
                "none",
                "pending",
                "green",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "failing": {
          "$ref": "#/$defs/names"
        },
        "mergeable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "mergeable_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "type": "null"
            }
          ]
        },
        "rebaseable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewers": {
          "$ref": "#/$defs/names"
        },
        "group": {
          "enum": [
            "ready",
            "checks",
            "conflict",
            "draft",
            "blocked"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "checks-red",
                "no-checks",
                "unknown",
                "review-or-protection",
                "unstable",
                "not-rebaseable",
                "not-read",
                "parent-conflict"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "detail": {
          "type": "boolean"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        },
        "hints": {
          "$ref": "#/$defs/hints"
        },
        "base_conflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/baseConflict"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "group": {
                "const": "ready"
              }
            },
            "required": [
              "group"
            ]
          },
          "then": {
            "properties": {
              "ready": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "ready": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "group": {
                "const": "blocked"
              }
            },
            "required": [
              "group"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "checks-red",
                  "no-checks",
                  "unknown",
                  "review-or-protection",
                  "unstable",
                  "not-rebaseable",
                  "not-read",
                  "parent-conflict"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "detail": {
                "const": false
              }
            },
            "required": [
              "detail"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "type": "null"
              },
              "mergeable": {
                "type": "null"
              },
              "mergeable_state": {
                "type": "null"
              },
              "rebaseable": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "reviewState": {
      "enum": [
        "none",
        "findings",
        "clear",
        "clear-carried",
        "clear-stale",
        "unparsed"
      ]
    },
    "hint": {
      "enum": [
        "clear-not-ready",
        "no-final-review",
        "base-not-default",
        "parent-merged-retarget",
        "truncated-review-unknown",
        "foreign-review-ignored",
        "ready-mergeable"
      ]
    },
    "hints": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hint"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "basis",
        "state",
        "verdict",
        "head",
        "patch_id",
        "at",
        "url",
        "association",
        "ignored",
        "carried",
        "edited",
        "truncated"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "comment"
        },
        "state": {
          "$ref": "#/$defs/reviewState"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "CLEAR",
                "FINDINGS"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "patch_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "association": {
          "anyOf": [
            {
              "enum": [
                "OWNER",
                "MEMBER",
                "COLLABORATOR"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ignored": {
          "type": "integer",
          "minimum": 0
        },
        "carried": {
          "type": "boolean"
        },
        "edited": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "none",
                  "unparsed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "type": "null"
              },
              "head": {
                "type": "null"
              },
              "patch_id": {
                "type": "null"
              },
              "at": {
                "type": "null"
              },
              "url": {
                "type": "null"
              },
              "carried": {
                "const": false
              },
              "edited": {
                "const": false
              },
              "association": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "verdict": {
                "enum": [
                  "CLEAR",
                  "FINDINGS"
                ]
              },
              "head": {
                "$ref": "#/$defs/sha"
              },
              "patch_id": {
                "type": "string"
              },
              "at": {
                "$ref": "#/$defs/time"
              },
              "association": {
                "enum": [
                  "OWNER",
                  "MEMBER",
                  "COLLABORATOR"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "clear-carried"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "carried": {
                "const": true
              },
              "verdict": {
                "const": "CLEAR"
              }
            }
          },
          "else": {
            "properties": {
              "carried": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "clear",
                  "clear-stale"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "CLEAR"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "findings"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "FINDINGS"
              }
            }
          }
        }
      ]
    },
    "baseConflict": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "base",
        "base_sha",
        "merge_base",
        "files",
        "overlap",
        "truncated",
        "blocked_by"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "clean",
            "conflicts-with-base",
            "unknown"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "fetch-failed",
                "head-moved",
                "ref-invalid",
                "past-probe-limit",
                "probe-failed",
                "no-merge-base"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "$ref": "#/$defs/str"
        },
        "base_sha": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "merge_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "path",
              "base_commit"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/str"
              },
              "base_commit": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "overlap": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/str"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "blocked_by": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Probe merge of a pull request against the current tip of its base (Spec 047). files lists the conflicting files with the last base commit that touched them; overlap lists, for a clean merge, the files both sides changed."
    },
    "stackLevel": {
      "type": "object",
      "required": [
        "number",
        "depth",
        "parent",
        "head",
        "clear",
        "ci",
        "conflict",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "clear": {
          "enum": [
            "valid",
            "invalid",
            "none",
            "unknown"
          ]
        },
        "ci": {
          "enum": [
            "none",
            "pending",
            "green",
            "red",
            "-"
          ]
        },
        "conflict": {
          "enum": [
            "clean",
            "conflicts-with-base",
            "unknown"
          ]
        },
        "status": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "blocked: restack needed"
                },
                {
                  "type": "string",
                  "pattern": "^blocked by #[1-9][0-9]*$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "restackStep": {
      "type": "object",
      "required": [
        "number",
        "head_ref",
        "old_head",
        "why",
        "skip",
        "rebase",
        "verify",
        "push"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_ref": {
          "$ref": "#/$defs/str"
        },
        "old_head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "$ref": "#/$defs/str"
        },
        "skip": {
          "anyOf": [
            {
              "$ref": "#/$defs/str"
            },
            {
              "type": "null"
            }
          ]
        },
        "rebase": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "verify": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "push": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Commands as text; push runs only after the review of the new head. Nothing is executed by stw."
    },
    "restackPlan": {
      "type": "object",
      "required": [
        "repo",
        "remote",
        "root",
        "steps",
        "gh_stack",
        "brief"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "remote": {
          "$ref": "#/$defs/str"
        },
        "root": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/restackStep"
          }
        },
        "gh_stack": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "brief": {
          "type": "string",
          "maxLength": 200000
        }
      }
    },
    "conflictsDoc": {
      "type": "object",
      "required": [
        "remote",
        "stacks",
        "plans"
      ],
      "additionalProperties": false,
      "properties": {
        "remote": {
          "$ref": "#/$defs/str"
        },
        "stacks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "repo",
              "root",
              "levels"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "$ref": "#/$defs/repo"
              },
              "root": {
                "type": "integer",
                "minimum": 1
              },
              "levels": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "$ref": "#/$defs/stackLevel"
                }
              }
            }
          }
        },
        "plans": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/restackPlan"
          }
        }
      },
      "description": "Stack view and restack plans of the base conflicts (Spec 047); null without --conflicts."
    },
    "queueEntry": {
      "type": "object",
      "required": [
        "position",
        "repo",
        "number",
        "title",
        "url",
        "head",
        "review",
        "reason",
        "then"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/str"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "enum": [
            "clear",
            "clear-carried"
          ]
        },
        "reason": {
          "$ref": "#/$defs/str"
        },
        "then": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "stackNode": {
      "type": "object",
      "required": [
        "repo",
        "number",
        "title",
        "url",
        "draft",
        "group",
        "checks",
        "review",
        "hints",
        "base",
        "head_ref",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/str"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "group": {
          "enum": [
            "ready",
            "checks",
            "conflict",
            "draft",
            "blocked"
          ]
        },
        "checks": {
          "anyOf": [
            {
              "enum": [
                "none",
                "pending",
                "green",
                "red"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/reviewState"
            },
            {
              "type": "null"
            }
          ]
        },
        "hints": {
          "$ref": "#/$defs/hints"
        },
        "base": {
          "$ref": "#/$defs/str"
        },
        "head_ref": {
          "$ref": "#/$defs/str"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stackNode"
          }
        }
      }
    }
  }
}
