{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wstein.github.io/sourcesteward/schemas/v1/sync.schema.json",
  "title": "SourceSteward sync (schema 1)",
  "description": "Result of stw sync: one entry per repository of the workspace (the top-level superproject and every initialized submodule, nested ones too, main worktrees only), each synced on the branch it sits on; note is set when the command ran in a linked worktree, which it did not touch. mode plan fetches the remote-tracking refs and reports what a run would do (fast-forward, rebase, merge); mode sync fast-forwards or rebases the current branch like git pull and reports what happened. Exit statuses: 0 unless the run is refused (error is set) or a repository failed, conflicted or has an autostash conflict, 1 then, 2 usage error with no JSON. Keys are never omitted; absent values are null. Added properties are compatible extensions.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "mode",
    "run_id",
    "options",
    "note",
    "repos",
    "summary",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "sync"
    },
    "mode": {
      "enum": [
        "plan",
        "sync"
      ]
    },
    "run_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}([0-9]{6})?Z-[0-9a-f]{8}$"
        }
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "rebase",
        "prune",
        "autostash",
        "merge"
      ],
      "properties": {
        "rebase": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "prune": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "autostash": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "merge": {
          "type": "boolean"
        }
      }
    },
    "repos": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/repo"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "by_result"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "by_result": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "fast-forward",
              "rebase",
              "merge",
              "up-to-date",
              "ahead",
              "diverged",
              "skipped-dirty",
              "skipped-detached",
              "skipped-no-upstream",
              "skipped-busy",
              "skipped-uninitialized",
              "fast-forwarded",
              "rebased",
              "merged",
              "conflict",
              "autostash-conflict",
              "failed"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^sync-[a-z-]+$"
            },
            "message": {
              "type": "string",
              "maxLength": 260
            }
          }
        }
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "null"
          },
          "repos": {
            "items": {
              "properties": {
                "result": {
                  "enum": [
                    "fast-forward",
                    "rebase",
                    "merge",
                    "up-to-date",
                    "ahead",
                    "diverged",
                    "skipped-dirty",
                    "skipped-detached",
                    "skipped-no-upstream",
                    "skipped-busy",
                    "skipped-uninitialized"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "sync"
          }
        }
      },
      "then": {
        "properties": {
          "repos": {
            "items": {
              "properties": {
                "result": {
                  "enum": [
                    "up-to-date",
                    "ahead",
                    "diverged",
                    "skipped-dirty",
                    "skipped-detached",
                    "skipped-no-upstream",
                    "skipped-busy",
                    "skipped-uninitialized",
                    "fast-forwarded",
                    "rebased",
                    "merged",
                    "conflict",
                    "autostash-conflict",
                    "failed"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "repo": {
      "type": "object",
      "required": [
        "name",
        "path",
        "kind",
        "branch",
        "remote",
        "result",
        "old_oid",
        "new_oid",
        "ahead",
        "behind",
        "pruned",
        "reason",
        "detail"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "root",
            "submodule"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "result": {
          "enum": [
            "fast-forward",
            "rebase",
            "merge",
            "up-to-date",
            "ahead",
            "diverged",
            "skipped-dirty",
            "skipped-detached",
            "skipped-no-upstream",
            "skipped-busy",
            "skipped-uninitialized",
            "fast-forwarded",
            "rebased",
            "merged",
            "conflict",
            "autostash-conflict",
            "failed"
          ]
        },
        "old_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/oid"
            }
          ]
        },
        "new_oid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/oid"
            }
          ]
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "pruned": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "fast-forward",
                  "fast-forwarded",
                  "rebased",
                  "merged",
                  "autostash-conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "new_oid": {
                "$ref": "#/$defs/oid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "up-to-date",
                  "ahead",
                  "skipped-detached",
                  "skipped-no-upstream",
                  "skipped-uninitialized",
                  "skipped-busy",
                  "diverged",
                  "failed",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "new_oid": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "diverged",
                  "skipped-dirty",
                  "skipped-detached",
                  "skipped-no-upstream",
                  "skipped-busy",
                  "skipped-uninitialized",
                  "conflict",
                  "autostash-conflict",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "conflict",
                  "autostash-conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "detail": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
