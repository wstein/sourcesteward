 {
  "name": "allowed: listed imports and time values",
  "source": "package p\nimport (\n\t\"fmt\"\n\ttm \"time\"\n\t\"github.com/wstein/sourcesteward/internal/attribution\"\n)\nvar _ tm.Duration = tm.Second\nvar _ = fmt.Sprint\n",
  "violation": false
 },
 {
  "name": "allowed: Errorf Sprintf Sprintln",
  "source": "package p\nimport \"fmt\"\nvar _ = fmt.Errorf(\"x\")\nvar _ = fmt.Sprintf(\"%d\", 1)\nvar _ = fmt.Sprintln(1)\n",
  "violation": false
 },
 {
  "name": "allowed: time constants and RFC3339",
  "source": "package p\nimport \"time\"\nvar _ time.Duration = 5 * time.Millisecond\nvar _ = time.RFC3339\nvar _ time.Time\n",
  "violation": false
 },
 {
  "name": "allowed: strings.Index is not the In method",
  "source": "package p\nimport \"strings\"\nvar _ = strings.Index(\"a\", \"b\")\n",
  "violation": false
 },
 {
  "name": "allowed: initialize is not init",
  "source": "package p\nfunc initialize() {}\n",
  "violation": false
 }
