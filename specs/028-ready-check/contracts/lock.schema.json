{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unpublished Ready lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "generation",
    "policy_source",
    "checker",
    "deployment",
    "transition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "id",
        "full_name",
        "base_ref"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 201
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "policy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "full_name",
        "commit",
        "sha256"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 201
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "artifact_sha256"
      ],
      "properties": {
        "source_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "environment",
        "publisher_app_id"
      ],
      "properties": {
        "profile": {
          "enum": [
            "none",
            "required-workflow",
            "protected-source",
            "app"
          ]
        },
        "environment": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher_app_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "transition": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "number",
            "head_sha",
            "old_generation",
            "old_policy_sha256",
            "new_policy_commit",
            "new_policy_sha256",
            "new_checker_source_sha",
            "new_checker_artifact_sha256"
          ],
          "properties": {
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "head_sha": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            },
            "old_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "old_policy_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "new_policy_commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            },
            "new_policy_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "new_checker_source_sha": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            },
            "new_checker_artifact_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
