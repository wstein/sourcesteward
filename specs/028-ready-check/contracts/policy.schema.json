{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unpublished Ready policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "repository",
    "review",
    "ci",
    "merge",
    "deployment",
    "trust_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "id",
        "full_name",
        "base_ref"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 201
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "status_creator_ids",
        "report_author_ids",
        "tiers",
        "default_tier",
        "path_tiers",
        "max_rounds",
        "independence",
        "allow_low_followups"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status_creator_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "report_author_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "rank",
              "models"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "effort"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                    },
                    "effort": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "default_tier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "path_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefix",
              "tier"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "tier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "independence": {
          "const": "declared-execution"
        },
        "allow_low_followups": {
          "type": "boolean"
        }
      }
    },
    "ci": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "app_id",
          "creator_ids"
        ],
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "app_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "creator_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "require_strict"
      ],
      "properties": {
        "method": {
          "const": "rebase"
        },
        "require_strict": {
          "type": "boolean"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "publisher_app_id"
      ],
      "properties": {
        "profile": {
          "enum": [
            "none",
            "required-workflow",
            "protected-source",
            "app"
          ]
        },
        "publisher_app_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trust_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    }
  }
}
