{
  "format_version": 1,
  "name": "human-lines-untrusted-text",
  "kind": "vectors",
  "description": "Text from the forge in a `--human` line never carries raw control characters, bidi or line separators, and a line is one line and bounded. The exact escaping is Go's (`untrusted.Esc`); the Rust port escapes differently (deviation D6), so only the properties are the contract.",
  "source": {
    "go_tests": [
      "watchcmd/human_test.go:TestHumanEscapesControlCharactersAndBoundsText",
      "watchcmd/human_test.go:TestHumanEscapesEveryTextField"
    ]
  },
  "format_dependent": [
    "go_line"
  ],
  "function": "human_line_properties",
  "cases": [
    {
      "name": "new-pr title with escape, newline, bidi",
      "input": {
        "event": {
          "schema_version": 1,
          "seq": 1,
          "id": "x",
          "time": "2026-10-22T10:04:10Z",
          "repo": "o/r",
          "pr": 1,
          "kind": "new-pr",
          "details": {
            "title": "a\u001b[31mred\nline‮\u0000",
            "author": "al\rice",
            "draft": false,
            "base": "main",
            "head_ref": "",
            "head": "1111111111111111111111111111111111111111",
            "fork": false
          }
        }
      },
      "expected": {
        "at_most_400_runes": true,
        "go_line": "10:04:10 o/r#1 new-pr a\\x1b[31mred\\nline\\u202e\\x00 by al\\rice into main",
        "no_raw_control_characters": true,
        "single_line": true
      }
    },
