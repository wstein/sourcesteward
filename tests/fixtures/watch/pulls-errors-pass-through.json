          "echo_authorization_header": false
        }
      ],
      "note": ""
    }
  ],
  "expected": [
    {
      "call": 1,
      "error": {
        "code": "repo-moved",
        "status": 301,
        "new_name": "new/name",
        "retry_after_seconds": 0,
        "rate_limit": null,
        "message_leaks_secret_or_body": false,
        "message_at_most_200_bytes": true,
        "canceled": false
      },
      "response": null,
      "list": null,
      "rate_info": null,
      "requests": [
        {
          "uri": "repos/a/b/pulls?state=open&per_page=25&page=1",
          "if_none_match": ""
        }
      ]
    },
    {
      "call": 2,
      "error": {
        "code": "rate-limited",
        "status": 403,
        "new_name": "",
        "retry_after_seconds": 30,
        "rate_limit": null,
        "message_leaks_secret_or_body": false,
        "message_at_most_200_bytes": true,
        "canceled": false
