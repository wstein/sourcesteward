{
  "format_version": 1,
  "name": "event-json-shapes",
  "kind": "vectors",
  "description": "The JSON object of an event as Go writes it (every kind, no key omitted, lists never null) and the objects Go refuses to decode (unknown key, unknown kind, wrong schema version). The lines are format-dependent in key order and escaping; the key sets per kind and the refusals are the contract.",
  "source": {
    "go_tests": [
      "event_test.go:TestEveryKindHasExactlyTheContractKeysAndNeverOmitsOne",
      "event_test.go:TestEventJSONRoundTripAndStrictDetails"
    ]
  },
  "format_dependent": [
    "line"
  ],
  "function": "event_json",
  "cases": [
    {
      "name": "decode missing detail key",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"closed\",\"details\":{\"head\":\"a\"}}",
        "op": "decode"
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "decode reserved review kind",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"review-state-changed\",\"details\":{}}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
    {
      "name": "decode schema version 2",
      "input": {
        "line": "{\"schema_version\":2,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"closed\",\"details\":{\"head\":\"a\",\"base\":\"b\"}}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
    {
      "name": "decode trailing data",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"closed\",\"details\":{\"head\":\"a\",\"base\":\"b\"}} {}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
    {
      "name": "decode unknown detail key",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"head-changed\",\"details\":{\"old\":\"a\",\"new\":\"b\",\"extra\":1}}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
    {
      "name": "decode unknown envelope key",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"closed\",\"details\":{\"head\":\"a\",\"base\":\"b\"},\"extra\":1}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
    {
      "name": "decode unknown kind",
      "input": {
        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"t\",\"repo\":null,\"pr\":null,\"kind\":\"nope\",\"details\":{}}",
        "op": "decode"
      },
      "expected": {
        "accepted": false
      }
    },
