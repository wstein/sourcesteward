        "line": "{\"schema_version\":1,\"seq\":1,\"id\":\"x\",\"time\":\"2026-10-22T09:00:00Z\",\"repo\":\"o/r\",\"pr\":7,\"kind\":\"base-changed\",\"details\":{\"old\":\"a\",\"new\":\"b\"}}"
