{
  "format_version": 1,
  "name": "restack-candidates",
  "kind": "vectors",
  "description": "Which open PRs must be restacked after a merge: class 1 child-of-merged-branch by the base name alone, class 2 contains-merged-commits by the old parent in the commit list (at most 3 pages), ascending by PR number. The `argv` of a candidate is Go's fixed git command; it is null for a fork head or an unknown merge commit (owner decision F1: kept as in Go, an exception to D-20261103-03).",
  "source": {
    "go_tests": [
      "restack_test.go:TestRestackRebaseMergeFixture",
      "restack_test.go:TestRestackNullsAndFork",
      "restack_test.go:TestRestackPagingAndCap",
      "restack_test.go:TestRestackSkipsUnnamableBranch",
      "restack_test.go:TestRestackErrors",
      "restack_test.go:TestRestackHeadRefEqualsBaseUsesCommitCheck",
      "restack_test.go:TestRestackForkHeadHasNoClassOne",
      "restack_test.go:TestRestackStopsAtFirstHit"
    ]
  },
  "format_dependent": [],
  "function": "restack_candidates",
  "cases": [
    {
      "name": "recorded rebase merge (testdata/rebase_merge.json): class 1 by base name, class 2 by the old head in the child's commits",
      "input": {
        "due": {
          "merged_pr": 10,
          "merge_commit": "34efceb54ad88a9efc691e507a0c70558ab6ca8b",
          "old_parent": "a97d7c5fd03a128f55bb0e37910bc29b88699100",
          "base": "main",
          "head_ref": "parent",
          "head_fork": false
        },
        "open": [
          {
            "number": 11,
            "base": "parent",
            "head_ref": "child-a",
            "head": "c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1",
            "fork": false
          },
          {
            "number": 12,
            "base": "main",
            "head_ref": "child",
            "head": "c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2",
            "fork": false
          },
          {
            "number": 99,
            "base": "main",
            "head_ref": "unrelated",
            "head": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "fork": false
          },
          {
            "number": 98,
            "base": "other",
            "head_ref": "elsewhere",
            "head": "ffffffffffffffffffffffffffffffffffffffff",
            "fork": false
          }
        ],
        "commit_lists": {
          "11": [
            "b501c2a98522229a331b3c2e91c478c117cdc9ce",
            "b1af07a5113fe7198ec7b2b965d52acef825cbbc"
          ],
          "12": [
            "226d30bb2c2dc3e65322bcb41a4f50f6da7ec4f5",
            "a97d7c5fd03a128f55bb0e37910bc29b88699100",
            "b501c2a98522229a331b3c2e91c478c117cdc9ce",
            "b1af07a5113fe7198ec7b2b965d52acef825cbbc"
          ],
          "99": [
            "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
          ]
        },
        "page_size": 0,
        "commit_errors": null,
        "branch_name_rule": ""
      },
      "expected": {
        "candidates": [
          {
            "pr": 11,
            "reason": "child-of-merged-branch",
            "branch": "child-a",
            "argv": [
              "git",
              "-c",
              "rebase.updateRefs=false",
              "-c",
              "rerere.enabled=false",
              "rebase",
              "--onto",
              "34efceb54ad88a9efc691e507a0c70558ab6ca8b",
              "a97d7c5fd03a128f55bb0e37910bc29b88699100",
              "child-a"
            ]
          },
          {
            "pr": 12,
            "reason": "contains-merged-commits",
            "branch": "child",
            "argv": [
              "git",
              "-c",
              "rebase.updateRefs=false",
              "-c",
              "rerere.enabled=false",
              "rebase",
              "--onto",
              "34efceb54ad88a9efc691e507a0c70558ab6ca8b",
              "a97d7c5fd03a128f55bb0e37910bc29b88699100",
              "child"
            ]
          }
        ],
        "commit_reads": [
          "12:1",
          "99:1"
        ],
        "diagnostics": 0,
        "diagnostic_prs": [],
        "error": ""
      }
    },
