{
  "format_version": 1,
  "name": "watch-prepare-flags",
  "kind": "vectors",
  "description": "The validated run of `stw watch` from its flags (and a config file given as text): defaults (stream, 60 s, detail every 10, pending timeout 45 min, 2000 open PRs), `--until-event` (timeout 590 s), the flags that exclude each other and every usage error (exit 2: nothing read, nothing written), the config merge (flags win), and the state directory of `--status`.",
  "source": {
    "go_tests": [
      "watchcmd/prepare_test.go:TestPrepareDefaults",
      "watchcmd/prepare_test.go:TestPrepareRejectsInvalidCombinations",
      "watchcmd/prepare_test.go:TestPrepareMergesTheConfigAndLetsFlagsOverrideIt",
      "watchcmd/prepare_test.go:TestPrepareStatusResolvesTheStateDirectory"
    ]
  },
  "format_dependent": [
    "go_message"
  ],
  "function": "prepare_flags",
