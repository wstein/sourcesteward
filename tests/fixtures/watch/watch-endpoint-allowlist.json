    "go_tests": [
      "watch_endpoint_test.go:TestWatchEndpointAllowlist",
      "watch_ratelimit_test.go:TestWatchGuardRefusesEveryWriteMethodOnEveryWatchEndpoint"
    ]
  },
  "format_dependent": [],
