            "summary": "Unexpected synthetic merge parents",
            "text": ""
          }
        ],
        "statuses": [],
        "base": "feature",
        "default_branch": "main",
        "stack_patterns": []
      },
      "expected": {
        "class": "red",
        "total": 1,
        "failing": [
          "a"
        ],
        "failing_total": 1,
        "pending": [],
        "shape": "stack-merge-shape"
