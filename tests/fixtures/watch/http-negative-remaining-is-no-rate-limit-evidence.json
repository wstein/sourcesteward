  "calls": [
    {
      "op": "pull_detail",
      "repo": "a/b",
      "number": 7,
      "page": 0,
      "per_page": 0,
      "name": "",
      "sha": "",
      "if_none_match": "",
      "max_open_prs": 0,
      "prior_list_state": "",
      "prior_per_page": 0,
      "new_reader_before": false,
      "reader_already_halved": false,
      "set_routes": null,
      "note": ""
    }
  ],
  "expected": [
    {
      "call": 1,
      "error": {
        "code": "forbidden",
        "status": 403,
        "new_name": "",
        "retry_after_seconds": 0,
        "rate_limit": null,
        "message_leaks_secret_or_body": false,
        "message_at_most_200_bytes": true,
        "canceled": false
      },
      "response": null,
      "list": null,
      "rate_info": null,
      "requests": [
        {
          "uri": "repos/a/b/pulls/7",
          "if_none_match": ""
        }
      ]
    }
  ]
