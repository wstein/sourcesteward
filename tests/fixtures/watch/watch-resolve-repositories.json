{
  "format_version": 1,
  "name": "watch-resolve-repositories",
  "kind": "vectors",
  "description": "The repository set of a run: --repo flags, then the workspace members with a GitHub remote on the host, then the config repos, in this order, without duplicates (case-insensitive); everything else in the workspace is skipped and reported with a reason; no source, a bad name, a failing discovery, a workspace without a GitHub repository and more than 256 repositories are usage errors.",
  "source": {
    "go_tests": [
      "watchcmd/resolve_test.go:TestResolveUnionsFlagsWorkspaceAndConfigInOrder",
      "watchcmd/resolve_test.go:TestResolveUsageErrors"
    ]
  },
  "format_dependent": [
    "go_message",
    "skipped_reason"
  ],
  "function": "resolve_repositories",
  "cases": [
    {
      "name": "flags, workspace and config in order, duplicates removed",
      "input": {
        "host": "github.com",
        "repo_flags": [
          "x/first",
          "O/A"
        ],
        "workspace": true,
        "config_repos": [
          "c/one",
          "x/FIRST"
        ],
        "has_config": true,
        "workspace_members": [
          {
            "name": ".",
            "initialized": true,
            "remote": "https://github.com/o/root.git"
          },
          {
            "name": "a",
            "initialized": true,
            "remote": "git@github.com:o/a.git"
          },
          {
            "name": "gl",
            "initialized": true,
            "remote": "https://gitlab.com/o/gl"
          },
          {
            "name": "loc",
            "initialized": true,
            "remote": "/srv/git/loc"
          },
          {
            "name": "bare",
            "initialized": true,
            "remote": ""
          },
          {
            "name": "off",
            "initialized": false,
            "remote": ""
          }
        ],
        "workspace_root": "/ws",
        "discovery_fails": false
      },
      "expected": {
        "ok": true,
        "repos": [
          "x/first",
          "O/A",
          "o/root",
          "c/one"
        ],
        "workspace_root": "/ws",
        "skipped": [
          {
            "path": "gl",
            "skipped_reason": "remote is not a GitHub repository on github.com"
          },
          {
            "path": "loc",
            "skipped_reason": "remote is not a GitHub repository on github.com"
          },
          {
            "path": "bare",
            "skipped_reason": "no remote"
          },
          {
            "path": "off",
            "skipped_reason": "not initialized"
          }
        ],
        "go_message": ""
      }
    },
    {
      "name": "no source",
      "input": {
        "host": "github.com",
        "repo_flags": [],
        "workspace": false,
        "config_repos": [],
        "has_config": false,
        "workspace_members": [],
        "workspace_root": "",
        "discovery_fails": false
      },
      "expected": {
        "ok": false,
        "repos": [],
        "workspace_root": "",
        "skipped": [],
        "go_message": "no repository: give --repo, --workspace or a config file with repos"
      }
    },
    {
      "name": "bad repo flag",
      "input": {
        "host": "github.com",
        "repo_flags": [
          "nonsense"
        ],
        "workspace": false,
        "config_repos": [],
        "has_config": false,
        "workspace_members": [],
        "workspace_root": "",
        "discovery_fails": false
      },
      "expected": {
        "ok": false,
        "repos": [],
        "workspace_root": "",
        "skipped": [],
        "go_message": "--repo \"nonsense\" is not OWNER/NAME"
      }
    },
    {
      "name": "discovery fails",
      "input": {
        "host": "github.com",
        "repo_flags": [],
        "workspace": true,
        "config_repos": [],
        "has_config": false,
        "workspace_members": [],
        "workspace_root": "",
        "discovery_fails": true
      },
      "expected": {
        "ok": false,
        "repos": [],
        "workspace_root": "",
        "skipped": [],
        "go_message": "--workspace: not a repository"
      }
    },
    {
      "name": "a workspace without any GitHub repository",
      "input": {
        "host": "github.com",
        "repo_flags": [],
        "workspace": true,
        "config_repos": [],
        "has_config": false,
        "workspace_members": [
          {
            "name": ".",
            "initialized": true,
            "remote": "/x"
          }
        ],
        "workspace_root": "/ws",
        "discovery_fails": false
      },
      "expected": {
        "ok": false,
        "repos": [],
        "workspace_root": "/ws",
        "skipped": [
          {
            "path": ".",
            "skipped_reason": "remote is not a GitHub repository on github.com"
          }
        ],
        "go_message": "--workspace: no member of /ws has a GitHub remote on github.com"
      }
    },
